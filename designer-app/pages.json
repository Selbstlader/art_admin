{
  "pages": [
    {
      "path": "pages/index/index",
      "style": {
        "navigationBarTitleText": "项目列表",
        "enablePullDownRefresh": true,
        "onReachBottomDistance": 50
      }
    },
    {
      "path": "pages/login/index",
      "style": {
        "navigationBarTitleText": "登录",
        "navigationStyle": "custom"
      }
    },
    {
      "path": "pages/project/detail",
      "style": {
        "navigationBarTitleText": "项目详情",
        "enablePullDownRefresh": false
      }
    },
    {
      "path": "pages/project/documents",
      "style": {
        "navigationBarTitleText": "文档分析",
        "enablePullDownRefresh": true
      }
    },
    {
      "path": "pages/project/cost",
      "style": {
        "navigationBarTitleText": "成本报告",
        "enablePullDownRefresh": false
      }
    },
    {
      "path": "pages/project/designs",
      "style": {
        "navigationBarTitleText": "设计图",
        "enablePullDownRefresh": true
      }
    },
    {
      "path": "pages/chat/index",
      "style": {
        "navigationBarTitleText": "AI对话",
        "enablePullDownRefresh": false
      }
    },
    {
      "path": "pages/material/index",
      "style": {
        "navigationBarTitleText": "材料库",
        "enablePullDownRefresh": false
      }
    },
    {
      "path": "pages/material/list",
      "style": {
        "navigationBarTitleText": "材料列表",
        "enablePullDownRefresh": true,
        "onReachBottomDistance": 50
      }
    },
    {
      "path": "pages/material/detail",
      "style": {
        "navigationBarTitleText": "材料详情",
        "enablePullDownRefresh": false
      }
    },
    {
      "path": "pages/message/index",
      "style": {
        "navigationBarTitleText": "消息中心",
        "enablePullDownRefresh": true
      }
    },
    {
      "path": "pages/mine/index",
      "style": {
        "navigationBarTitleText": "我的",
        "enablePullDownRefresh": false
      }
    }
  ],
  "globalStyle": {
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "工装设计助手",
    "navigationBarBackgroundColor": "#FFFFFF",
    "backgroundColor": "#F5F7FA",
    "backgroundTextStyle": "dark",
    "enablePullDownRefresh": false,
    "onReachBottomDistance": 50
  },
  "tabBar": {
    "color": "#999999",
    "selectedColor": "#3B82F6",
    "borderStyle": "black",
    "backgroundColor": "#FFFFFF",
    "list": [
      {
        "pagePath": "pages/index/index",
        "iconPath": "static/tabbar/home.png",
        "selectedIconPath": "static/tabbar/home-active.png",
        "text": "首页"
      },
      {
        "pagePath": "pages/material/index",
        "iconPath": "static/tabbar/material.png",
        "selectedIconPath": "static/tabbar/material-active.png",
        "text": "材料库"
      },
      {
        "pagePath": "pages/chat/index",
        "iconPath": "static/tabbar/chat.png",
        "selectedIconPath": "static/tabbar/chat-active.png",
        "text": "AI对话",
        "visible": true
      },
      {
        "pagePath": "pages/message/index",
        "iconPath": "static/tabbar/message.png",
        "selectedIconPath": "static/tabbar/message-active.png",
        "text": "消息",
        "visible": true
      },
      {
        "pagePath": "pages/mine/index",
        "iconPath": "static/tabbar/mine.png",
        "selectedIconPath": "static/tabbar/mine-active.png",
        "text": "我的"
      }
    ]
  },
  "easycom": {
    "autoscan": true,
    "custom": {
      "^uni-(.*)": "@dcloudio/uni-ui/lib/uni-$1/uni-$1.vue"
    }
  },
  "condition": {
    "current": 0,
    "list": [
      {
        "name": "首页",
        "path": "pages/index/index"
      },
      {
        "name": "登录",
        "path": "pages/login/index"
      }
    ]
  }
}
