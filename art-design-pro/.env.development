# 开发环境配置
NODE_ENV=development

# 应用版本
VITE_VERSION=1.0.0

# 应用端口
VITE_PORT=5173

# 基础路径
VITE_BASE_URL=/

# API 基础地址（后端服务地址）
VITE_API_URL=http://localhost:48080

# API 代理地址（用于开发环境代理）
VITE_API_PROXY_URL=http://localhost:48080

# 是否携带凭证
VITE_WITH_CREDENTIALS=false

VITE_API_BASE_URL=http://localhost:48080
